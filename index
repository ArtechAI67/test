                                <input className="w-full md:w-80 pl-10 pr-4 py-3 bg-surface-container-lowest border border-runway-gray/20 rounded font-body-md text-body-md text-on-surface focus:outline-none focus:border-sky-blue focus:ring-1 focus:ring-sky-blue transition-all" placeholder="Search by role or location..." type="text" />
                            </div>
                        </div>
                        <div className="grid grid-cols-1 lg:grid-cols-2 gap-gutter">
                            {[
                                { title: 'Ramp Agent', loc: 'JFK - New York', dept: 'Ground Handling', type: 'Full-Time', desc: 'Ensure safe, efficient baggage handling and aircraft servicing on the ramp.' },
                                { title: 'Passenger Service Assistant', loc: 'YYZ - Toronto Pearson', dept: 'Passenger Services', type: 'Full-Time', desc: 'Deliver exceptional customer service assisting passengers with mobility needs.' }
                            ].map((job, idx) => (
                                <div key={idx} className="bg-surface-container-lowest p-stack-md rounded-lg border border-runway-gray/10 hover:shadow-[0_4px_20px_rgba(30,54,105,0.08)] transition-shadow duration-300 flex flex-col md:flex-row gap-6 items-start md:items-center justify-between group">
                                    <div className="flex-grow">
                                        <div className="flex flex-wrap gap-2 mb-3">
                                            <span className="bg-surface-cream text-airport-navy px-3 py-1 rounded text-caption font-caption inline-flex items-center gap-1 border border-runway-gray/10">
                                                <span className="material-symbols-outlined text-[16px]">location_on</span>{job.loc}
                                            </span>
                                            <span className="bg-clean-slate text-secondary px-3 py-1 rounded text-caption font-caption">{job.dept}</span>
                                            <span className="bg-sky-blue/10 text-airport-navy px-3 py-1 rounded text-caption font-caption font-semibold">{job.type}</span>
                                        </div>
                                        <h3 className="font-headline-md text-headline-md text-airport-navy mb-1 group-hover:text-sky-blue transition-colors">{job.title}</h3>
                                        <p className="font-body-md text-body-md text-runway-gray line-clamp-2">{job.desc}</p>
                                    </div>
                                    <button className="font-label-bold text-label-bold text-airport-navy border border-airport-navy px-6 py-2 rounded hover:bg-airport-navy hover:text-white transition-colors duration-200 whitespace-nowrap shrink-0">
                                        Apply Now
                                    </button>
                                </div>
                            ))}
                        </div>
                    </div>
                </section>
            </main>
        );

        const App = () => {
            return (
                <MemoryRouter>
                    <Header />
                    <Routes>
                        <Route path="/" element={<ServicesScreen />} />
                        <Route path="/careers" element={<CareersScreen />} />
                    </Routes>
                    <Footer />
                </MemoryRouter>
            );
        };

        const root = createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
